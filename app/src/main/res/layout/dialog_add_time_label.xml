<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Name"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/time_label_name_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g., Afternoon, Late Night"
        android:inputType="text"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Time Range"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <RelativeLayout
        android:id="@+id/time_range_display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:text="From:"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/time_label_from_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:text="06:00"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_below="@id/time_label_from_display"
            android:layout_marginTop="4dp"
            android:text="To:"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/time_label_to_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_below="@id/time_label_from_display"
            android:layout_marginTop="4dp"
            android:text="12:00"
            android:textSize="14sp" />

    </RelativeLayout>

</LinearLayout>
